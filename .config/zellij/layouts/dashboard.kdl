layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
        children
    }

    tab name="System" focus=true {
        pane split_direction="vertical" {
            pane command="btop" size="60%" {
                args "-u" "200" "--force-utf" "-c" "/home/winter/.config/btop/dashboard.conf"
            }
            pane split_direction="horizontal" {
                pane command="tty-clock" size="20%" {
                    args "-c" "-C" "6"
                }
                pane command="cava" size="40%" {
                    args "-p" "/home/winter/.config/cava/dashboard"
                }
                pane command="cmatrix" size="40%" {
                    args "-C" "red" "-b"
                }
            }
        }
    }

    tab name="Dev Hub" {
        pane split_direction="vertical" {
            // lazygit needs a repo as its cwd. The dashboard is launched from
            // niri with no meaningful working directory, so without cwd this
            // pane died with "not a git repository" - which is why it was left
            // as a bare shell that only had the name "Git".
            pane command="lazygit" cwd="/home/winter/dotfiles" size="50%"
            pane command="gh" size="50%" {
                args "dash"
            }
        }
    }

    tab name="Logs" {
        pane command="journalctl" {
            args "-f" "-n" "100"
        }
    }

    tab name="Terminal" {
        pane
    }
}
