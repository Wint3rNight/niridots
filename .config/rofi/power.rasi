* {
    bg:                         #0b0b0fdd;
    bg-alt:                     #14141bcc;
    fg:                         #d8d3c8;
    accent:                     #a02c3c;
    background-color:           transparent;
    text-color:                 @fg;
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    width:                      800px;
    height:                     400px;
    border:                     2px;
    border-radius:              20px;
    border-color:               @accent;
    background-color:           @bg;
}

mainbox {
    spacing:                    0px;
    children:                   [ "listview", "infobox" ];
    orientation:                horizontal;
}

listview {
    columns:                    2;
    lines:                      3;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    spacing:                    15px;
    margin:                     30px;
}

element {
    padding:                    30px 0px;
    border-radius:              15px;
    background-color:           @bg-alt;
}

element-text {
    font:                       "FantasqueSansM Nerd Font 30";
    background-color:           transparent;
    text-color:                 inherit;
    vertical-align:             0.5;
    horizontal-align:           0.5;
}

element selected.normal {
    background-color:           @accent;
    text-color:                 #0b0b0f;
}

infobox {
    expand:                     true;
    orientation:                vertical;
    background-color:           #00000066;
    padding:                    80px 40px;
    spacing:                    20px;
    children:                   [ "textbox-user", "textbox-uptime" ];
}

/* We use the generic 'textbox' type by naming them with a 'textbox-' prefix 
   or styling them as text-heavy elements */

textbox-user, textbox-uptime {
    vertical-align:             0.5;
    horizontal-align:           0.5;
    border-radius:              10px;
    padding:                    15px;
    expand:                     false;
}

textbox-user {
    background-color:           #a02c3c33;
    text-color:                 @accent;
    font:                       "FantasqueSansM Nerd Font Bold 11";
}

textbox-uptime {
    background-color:           #c9a22733;
    text-color:                 #c9a227;
    font:                       "FantasqueSansM Nerd Font 11";
}
