{
    "layer": "top",
    "position": "top",
    "height": 26,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "spacing": 0,
    "exclusive": true,
    "passthrough": false,
    "all-outputs": true,

    "modules-left": ["niri/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["custom/weather", "custom/notification", "pulseaudio", "network", "cpu", "memory", "battery", "tray"],

    "custom/weather": {
        "format": "{}",
        "tooltip": true,
        "interval": 900,
        "exec": "/usr/bin/python3 /home/winter/.config/waybar/weather.py",
        "return-type": "json"
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂚",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󱅫",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "/usr/bin/swaync-client -swb",
        "on-click": "/usr/bin/swaync-client -t -sw",
        "on-click-right": "/usr/bin/swaync-client -d -sw",
        "escape": true
    },

    "niri/workspaces": {
        "format": "{index}",
        "on-click": "activate"
    },

    "clock": {
        "format": "󱑊 {:%H:%M:%S}",
        "format-alt": "󰃭 {:%a, %d %b %Y}",
        "interval": 1,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click-right": "/usr/bin/kitty --class calendar-popup -e sh -c 'cal; read'"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "/home/winter/.local/bin/rofi-audio-menu",
        "on-click-right": "/usr/bin/pavucontrol",
        "on-scroll-up": "/usr/bin/wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "/usr/bin/wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "tooltip": true
    },

    "network": {
        "format-wifi": "󰤨  {essid}   󰓅  {bandwidthDownBits}",
        "format-ethernet": "󰈀   󰓅  {bandwidthDownBits}",
        "format-disconnected": "󰤮",
        "interval": 2,
        "on-click": "/home/winter/.local/bin/rofi-wifi-menu",
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "Disconnected"
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 2,
        "on-click": "/usr/bin/kitty --class system-stats -e /usr/bin/btop --force-utf"
    },

    "memory": {
        "format": "󰍛 {used}G",
        "interval": 2,
        "on-click": "/usr/bin/kitty --class system-stats -e /usr/bin/btop --force-utf"
    },

    "battery": {
        "interval": 30,
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}",
        "on-click": "/usr/bin/kitty --class system-stats -e /usr/bin/btop --force-utf"
    },

    "tray": {
        "icon-size": 20,
        "spacing": 10
    }
}
