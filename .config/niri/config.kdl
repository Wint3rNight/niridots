// This config is in the KDL format: https://kdl.dev
// "/-" comments out the following node.
// Check the wiki for a full description of the configuration:
// https://niri-wm.github.io/niri/Configuration:-Introduction

input {
    keyboard {
        xkb {}
    }
    touchpad {
        natural-scroll
        tap
    }
}

cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 16
}

output "eDP-1" {
    scale 1
    transform "normal"
    position x=0 y=0
}

layout {
    background-color "transparent"
    gaps 5
    center-focused-column "never"
    default-column-width { proportion 0.5; }

    // Soft translucent halo just outside the border - this is the "glow".
    focus-ring {
        width 3
        active-color "#a02c3c33"
    }

    border {
        width 2
        active-gradient from="#a02c3c" to="#c9a227" angle=45
        inactive-color "#23232e"
    }

    shadow {
        on
        softness 12
        spread 0
        offset x=0 y=6
        // No coloured halo. Gotham shadows are hard and near-black -- the glow
        // is what made this read as "rice" rather than "noir".
        color "#000000b0"
        inactive-color "#00000075"
    }
}

spawn-at-startup "dsearch" "serve"   // file search backend for the DMS launcher
spawn-at-startup "dms" "run"
// spawn-at-startup "swaync"   // retired: DMS owns notifications
// Idle: lock after 5 min, monitors off after 10, and always lock before suspend.
spawn-at-startup "sh" "-c" "pkill -x swayidle; swayidle -w timeout 300 '$HOME/Projects/qylock/quickshell-lockscreen/lock.sh' timeout 600 'niri msg action power-off-monitors' resume 'niri msg action power-on-monitors' before-sleep '$HOME/Projects/qylock/quickshell-lockscreen/lock.sh'"
// spawn-at-startup "awww-daemon"
// RETIRED (DMS has its own clipboard store)
// spawn-at-startup "sh" "-c" "wl-paste --watch cliphist store"
spawn-at-startup "sh" "-c" "/home/winter/.config/niri/launch-dashboard.sh"

// Qt apps ignore GTK settings entirely; this points them at qt6ct/qt5ct
// so they pick up the Cathedral palette instead of default Fusion grey.
environment {
    QT_QPA_PLATFORMTHEME "qt6ct"
    LANG "en_IN.UTF-8"
    DMS_DISABLE_MATUGEN "1"
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Laptop lid
switch-events {
    lid-close { spawn "systemctl" "suspend"; }
}

// ---------------------------------------------------------------------------
// Animations - "Aurora" feel.
//
// Aurora is a Hyprland rice, so none of its config ports directly. What makes
// it read as Aurora is the motion: springs with real overshoot rather than a
// flat ease. In niri that means a LOWER damping-ratio (more bounce; 1.0 is
// critically damped with no overshoot) and a HIGHER stiffness (snappier).
//
// Previously only three of these were configured at damping 0.8 / stiffness
// 400-500 - stiff and slow. All ten are now tuned.
//
// Dial the whole thing up or down with `slowdown` rather than editing each
// block: 1.3 = more languid, 0.8 = faster.
// ---------------------------------------------------------------------------
animations {
    slowdown 1.0

    // Pops in with visible overshoot - the signature Aurora bounce.
    window-open {
        spring damping-ratio=0.95 stiffness=480 epsilon=0.0001
    }

    // Closing should NOT bounce; it reads as a glitch. Fast and near-critical.
    window-close {
        spring damping-ratio=1.00 stiffness=520 epsilon=0.0001
    }

    // The scrollable-column slide. This is the motion you see most in niri,
    // so it is bouncy but deliberately restrained - overshoot here gets
    // nauseating fast.
    horizontal-view-movement {
        spring damping-ratio=0.90 stiffness=400 epsilon=0.0001
    }

    // Shuffling a window/column to a new position.
    window-movement {
        spring damping-ratio=0.92 stiffness=450 epsilon=0.0001
    }

    // Resizes settle quickly - wobbling geometry looks broken, not playful.
    window-resize {
        spring damping-ratio=0.96 stiffness=500 epsilon=0.0001
    }

    workspace-switch {
        spring damping-ratio=0.94 stiffness=440 epsilon=0.0001
    }

    overview-open-close {
        spring damping-ratio=0.92 stiffness=430 epsilon=0.0001
    }

    // Small transient toasts can be as bouncy as you like.
    config-notification-open-close {
        spring damping-ratio=0.90 stiffness=500 epsilon=0.0001
    }

    exit-confirmation-open-close {
        spring damping-ratio=0.94 stiffness=480 epsilon=0.0001
    }

    // Wants to feel instant, not animated.
    screenshot-ui-open {
        spring damping-ratio=0.98 stiffness=700 epsilon=0.0001
    }
}

// Noir is a weather condition. Grain keeps large black areas reading as film
// rather than flat digital, and saturation below 1.0 drains the wallpaper
// showing through instead of boosting it (1.2 was working against the look).
blur {
    passes 3
    offset 2.5
    noise 0.05
    saturation 1.0
}

// ---------------------------------------------------------------------------
// Window rules
//
// Niri applies rules top to bottom and the LAST matching rule wins for each
// property. So the catch-all defaults live at the top and the app-specific
// rules below them can override.
// ---------------------------------------------------------------------------

// Defaults for every window
window-rule {
    opacity 0.75
    geometry-corner-radius 12
    clip-to-geometry true
    background-effect {
        blur true
    }
}

window-rule {
    match is-active=true
    opacity 0.95
}

// Floating windows
window-rule {
    match is-floating=true
    opacity 0.95
}

window-rule {
    match is-floating=true is-active=false
    opacity 0.70
    background-effect {
        blur false
        xray false
    }
}

// Dashboard (launch-dashboard.sh)
window-rule {
    match app-id="stats-terminal"
    open-on-workspace "1"
    default-column-width { proportion 1.0; }
    opacity 0.70
}

window-rule {
    match app-id="stats-terminal" is-active=true
    opacity 0.80
}

// RETIRED (DMS replaced this) - system-stats (was waybar cpu/mem/battery click target)
// // Popups launched from waybar
// window-rule {
//     match app-id="system-stats"
//     open-floating true
//     default-column-width { proportion 0.5; }
//     default-window-height { proportion 0.7; }
// }

// RETIRED (DMS replaced this) - network-manager
// window-rule {
//     match app-id="network-manager"
//     // open-floating true
//     default-column-width { proportion 0.5; }
//     default-window-height { proportion 0.7; }
// }

window-rule {
    match app-id="calendar-popup"
    // open-floating true
    default-column-width { fixed 400; }
    default-window-height { fixed 300; }
}

// Apps
window-rule {
    match app-id="Spotify"
    // open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 600; }
}

window-rule {
    match app-id="mpv"
    open-floating true
}

window-rule {
    match title="(?i)^discord updater$"
    open-floating true
}

// ---------------------------------------------------------------------------
// Layer rules (bars, notifications, launchers, wallpaper)
// ---------------------------------------------------------------------------

// RETIRED (DMS replaced this) - waybar layer
// layer-rule {
//     match namespace="waybar"
//     shadow { off; }
//     opacity 0.99
//     // Flat edge-to-edge strip: square corners, no rounding.
//     geometry-corner-radius 0
// }

// DMS paints the wallpaper on a surface named "quickshell". Without this the
// backdrop is empty during workspace switches and shows as a grey band.
layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}

// Logged-in web app panels (web-panel.sh). Chrome --app windows only -
// Zen stays the default browser and is unaffected by this rule.
window-rule {
    match app-id="^chrome-"
    open-floating true
    default-column-width { proportion 0.34; }
    default-window-height { proportion 0.92; }
    opacity 0.97
}

// RETIRED (DMS replaced this) - swaync control center
// layer-rule {
//     match namespace="swaync-control-center"
//     background-effect {
//         blur true
//     }
//     shadow { off; }
//     geometry-corner-radius 12
//     opacity 0.99
// }

// RETIRED (DMS replaced this) - swaync notification
// layer-rule {
//     match namespace="swaync-notification-window"
//     shadow { off; }
// }

layer-rule {
    match namespace="rofi"
    background-effect {
        blur true
    }
    geometry-corner-radius 20
    shadow { off; }
    // border { off; }
    // focus-ring { off; }
}

binds {
    Mod+C { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    // Plain shell, no zellij. Use `zj` inside it if you want a session.
    Mod+T { spawn "sh" "-c" "NO_ZELLIJ=1 kitty"; }
    Mod+E { spawn "kitty" "yazi"; }
    Mod+V { spawn "sh" "-c" "/home/winter/.config/niri/launch-dashboard.sh"; }
    Mod+B { spawn "dms" "ipc" "call" "bar" "toggle" "index" "0"; }
    Mod+W { spawn "dms" "ipc" "call" "wallpaper" "next"; }
    Mod+Shift+W { spawn "dms" "ipc" "call" "dash" "toggle" "wallpaper"; }
    Mod+D { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+S { spawn "bash" "-c" "~/.config/niri/rofi-toggle.sh find"; }
    Mod+G { spawn "bash" "-c" "~/.config/niri/web-panel.sh chatgpt"; }
    Mod+Shift+G { spawn "bash" "-c" "~/.config/niri/web-panel.sh gemini"; }
    Mod+A { spawn "bash" "-c" "~/.config/niri/rofi-toggle.sh calc"; }
    Mod+M { spawn "dms" "ipc" "call" "dash" "toggle" "media"; }
    Mod+Period { spawn "bash" "-c" "~/.config/niri/rofi-toggle.sh emoji"; }
    Mod+Tab { spawn "bash" "-c" "~/.config/niri/rofi-toggle.sh windows"; }
    Mod+P { spawn "sh" "-c" "hyprpicker -a -f hex"; }

    // DankMaterialShell panels
    Mod+Shift+D { spawn "dms" "ipc" "call" "dash" "toggle" "overview"; }
    Mod+Shift+P { spawn "dms" "ipc" "call" "processlist" "toggle"; }
    Mod+Slash { spawn "dms" "ipc" "call" "keybinds" "toggle" "niri"; }
    Mod+Y { spawn "dms" "ipc" "call" "notepad" "toggle"; }
    Mod+Z { spawn "dms" "ipc" "call" "mux" "toggle"; }
    Mod+Ctrl+T       { spawn "bash" "-c" "~/.config/niri/theme-cycle.sh next"; }
    Mod+Ctrl+Shift+T { spawn "bash" "-c" "~/.config/niri/theme-cycle.sh reset"; }
    Mod+Shift+B { spawn "bash" "-c" "~/.config/niri/dms-bar-frame-toggle.sh"; }
    Mod+Shift+S { spawn "dms" "ipc" "call" "quickCapture" "fromClipboard" "edit"; }
    Mod+Shift+C { spawn "bash" "-c" "~/.config/niri/rofi-toggle.sh configs"; }
    Mod+X { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    // Lock now (qylock / quickshell). Theme: ~/.config/qylock/theme
    Mod+Shift+X { spawn "bash" "-c" "$HOME/Projects/qylock/quickshell-lockscreen/lock.sh"; }
    Mod+N { spawn "dms" "ipc" "call" "control-center" "toggle"; }
    Mod+Shift+N { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+Shift+V { spawn "dms" "ipc" "call" "control-center" "toggle"; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { reset-window-height; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Mouse bindings
    Mod+WheelScrollUp      cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollDown    cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp   cooldown-ms=150 { focus-column-left; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { focus-column-right; }

    Mod+Print { spawn "bash" "-c" "~/.config/niri/screenshot-area.sh"; }
    Mod+Q { close-window; }
    Mod+Shift+Space { toggle-window-floating; }

    // --- Free placement of a floating window -------------------------------
    // Float the window first with Mod+Shift+Space, then nudge it anywhere with
    // Mod+Alt+<arrow>. These go through `niri msg action` because
    // move-floating-window is IPC-only and is not a bindable action.
    Mod+Alt+Left  { spawn "niri" "msg" "action" "move-floating-window" "-x" "-50"; }
    Mod+Alt+Right { spawn "niri" "msg" "action" "move-floating-window" "-x" "+50"; }
    Mod+Alt+Up    { spawn "niri" "msg" "action" "move-floating-window" "-y" "-50"; }
    Mod+Alt+Down  { spawn "niri" "msg" "action" "move-floating-window" "-y" "+50"; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Alt+F { maximize-window-to-edges; }
    Mod+O { toggle-overview; }
    Mod+Shift+T { toggle-column-tabbed-display; }

    // Vim-style navigation
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+L { move-column-right; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+L { move-column-right; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // Vim-style workspace switching
    Mod+Alt+J { focus-workspace-down; }
    Mod+Alt+K { focus-workspace-up; }
    Mod+Escape { focus-workspace-previous; }

    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Ctrl+Up { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Shift+E { quit; }

    // Default workspace binds
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }

    // Screenshot actions
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // Volume control
    F2 { spawn "sh" "-c" "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && ~/.local/bin/volume-notify.sh"; }
    F3 { spawn "sh" "-c" "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ && ~/.local/bin/volume-notify.sh"; }

    // Brightness control
    F6 { spawn "sh" "-c" "brightnessctl set 5%- && ~/.local/bin/brightness-notify.sh"; }
    F7 { spawn "sh" "-c" "brightnessctl set 5%+ && ~/.local/bin/brightness-notify.sh"; }

    // Hardware media keys (also work while the screen is locked)
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "sh" "-c" "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ && ~/.local/bin/volume-notify.sh"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "sh" "-c" "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && ~/.local/bin/volume-notify.sh"; }
    XF86AudioMute         allow-when-locked=true { spawn "sh" "-c" "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && ~/.local/bin/volume-notify.sh"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioPlay         allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext         allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev         allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "sh" "-c" "brightnessctl set 5%+ && ~/.local/bin/brightness-notify.sh"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "sh" "-c" "brightnessctl set 5%- && ~/.local/bin/brightness-notify.sh"; }
}
