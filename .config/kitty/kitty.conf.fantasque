# ============================================================
#  Cathedral  —  near-black ground, blood accent, gilt ornament
#  Revert: ~/.config/.pre-gothic-*/restore.sh
# ============================================================

background_opacity 0.8
dynamic_background_opacity yes
confirm_os_window_close 0

window_padding_width 15

# ------------------------------------------------------------
# Font
# ------------------------------------------------------------
font_family      family="FantasqueSansM Nerd Font"
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size 11.0

symbol_map U+2800-U+28FF FantasqueSansM Nerd Font

# ------------------------------------------------------------
# Cursor
# ------------------------------------------------------------
cursor_shape beam
cursor_blink_interval 0
cursor_trail 3
cursor_trail_decay 0.1 0.4

# ------------------------------------------------------------
# Base — bone text, never white. Pure #ffffff breaks the mood.
# ------------------------------------------------------------
background            #0b0b0f
foreground            #d8d3c8
selection_background  #3a2028
selection_foreground  #efe9dd
cursor                #a02c3c
cursor_text_color     #0b0b0f
url_color             #c9a227
url_style             curly

# ------------------------------------------------------------
# Window / tab chrome
# ------------------------------------------------------------
active_border_color   #a02c3c
inactive_border_color #23232e
bell_border_color     #c9a227

tab_bar_style         powerline
tab_powerline_style   slanted
tab_bar_background    #08080b
active_tab_foreground   #0b0b0f
active_tab_background   #a02c3c
active_tab_font_style   bold
inactive_tab_foreground #7d7a86
inactive_tab_background #14141b

# ------------------------------------------------------------
# 16-colour ANSI palette — desaturated and warm-leaning.
# Blood and gilt are the only vivid slots; everything else is
# muted so they carry the accent weight. Inherited by zellij,
# btop, cava, eza, bat, yazi, fastfetch and fzf.
# ------------------------------------------------------------

# black
color0  #0b0b0f
color8  #4a4550
# red — blood
color1  #a02c3c
color9  #c84a58
# green — moss, heavily desaturated
color2  #6b7a4f
color10 #8a9a68
# yellow — gilt
color3  #c9a227
color11 #e0bc4a
# blue — cold slate, deliberately dull
color4  #4a5a7a
color12 #6b7d9e
# magenta — dusty plum
color5  #7d5a7a
color13 #9c7599
# cyan — verdigris, aged copper
color6  #5f7d78
color14 #7d9c96
# white — bone
color7  #d8d3c8
color15 #efe9dd
